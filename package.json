{
  "name": "guides-tours",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 3020 --strictPort",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4020 --strictPort",
    "preview:worker": "wrangler dev --config dist/server/wrangler.json --ip 127.0.0.1 --port 3201 --local",
    "preview:worker:dryrun": "wrangler deploy --dry-run --outdir /tmp/wrangler-dryrun --config .wrangler/deploy/config.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check --error-on-warnings",
    "deploy:check": "node scripts/deploy-check.mjs",
    "deploy": "pnpm deploy:check && pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.48.0",
    "@convex-dev/better-auth": "0.12.5",
    "@convex-dev/react-query": "^0.1.0",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-pacer": "^0.22.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-router-with-query": "^1.130.17",
    "@tanstack/react-start": "1.168.32",
    "@tanstack/router-plugin": "^1.168.23",
    "better-auth": "1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.42.3",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.4",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "0.8.1",
    "@tanstack/react-devtools": "0.10.8",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/router-cli": "^1.167.21",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "convex-test": "^0.0.54",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
